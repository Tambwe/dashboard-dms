{
  "expo": {
    "name": "DMS Mobile Collector",
    "slug": "dms-mobile-collector",
    "owner": "kayuyu",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2b7bb5",
          "defaultChannel": "default"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dms.mobilecollector",
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "eas": {
        "projectId": "181150ee-1bab-4d0f-a3f1-081645726be9"
      }
    }
  }
}
